# Copy this file to .env and fill in real values. .env is gitignored.

# Azure DevOps organization URL (no trailing slash)
AZDO_ORG_URL=https://dev.azure.com/your-org

# Personal Access Token. Scopes required:
#   - Project and Team: Read, write, & manage
#   - Code: Read & write (sandbox commits, PRs, and PR attachments)
#   - Pull Request Threads: Read & write
#   - Identity: Read
#   - Marketplace: Acquire & Manage
#   - User Profile: Read
AZDO_PAT=

# Sandbox project name (created by scripts/setup-ado-sandbox.mjs). The repos,
# files, PRs, and threads are defined declaratively under sandbox/manifest.json,
# so this is the only sandbox value the script needs.
AZDO_TEST_PROJECT=markdown-review-sandbox-v2

# Marketplace publisher ID — fill in after creating one at
# https://aka.ms/vsmarketplace-manage-publishers (required only when publishing the dev extension).
AZDO_PUBLISHER_ID=

# Suffix appended to the dev extension id + contribution titles so the private
# dev build never collides with a co-installed prod extension. Default: devlocal.
AZDO_DEV_ID_SUFFIX=devlocal

# ---------------------------------------------------------------------------
# E2E (Playwright) — each dev supplies their OWN account here. Nothing in the
# repo hard-codes a specific identity; these override the generic placeholders.
# ---------------------------------------------------------------------------

# Installed dev-extension id the e2e specs address by URL. Defaults to
# <AZDO_PUBLISHER_ID>.easy-markdown-review-<AZDO_DEV_ID_SUFFIX>; set explicitly
# only if you installed it under a different id.
AZDO_E2E_EXTENSION_ID=

# Account hint shown by `npm run e2e:auth` (cosmetic reminder of which identity
# to sign in with), e.g. you@example.com.
AZDO_E2E_ACCOUNT=

