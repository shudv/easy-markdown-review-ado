# Secrets — NEVER commit
.env
.env.local
.env.*.local

# Sandbox metadata (contains IDs but no secrets; gitignored to keep dev env private)
.ado-sandbox.json

# Locally-generated dev TLS cert (per-machine; never committed).
certs/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build artefacts
dist/
build/
out/
*.vsix
.webpack-cache/
# Temporary dev manifest generated by scripts/package-extension.mjs --mode dev
vss-extension.dev.generated.json

# Test / coverage artefacts
coverage/
.nyc_output/
playwright-report/
playwright-report-visual/
test-results/
# Built Storybook (source of the visual-regression screenshots; rebuilt on demand)
storybook-static/
# Persisted ADO login for the e2e inner loop (per-machine; never committed).
e2e/.auth/

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
.DS_Store
Thumbs.db

# TypeScript incremental build
*.tsbuildinfo

.stryker-tmp/
# Stryker mutation-testing HTML report + incremental cache
reports/
*.log