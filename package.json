{
  "name": "easy-markdown-review",
  "version": "0.0.1",
  "private": true,
  "description": "Azure DevOps extension adding a Word-doc-style review experience to Markdown — PR comments on rendered prose plus a project-wide Documents hub.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "scripts": {
    "setup:sandbox": "node --env-file=.env scripts/setup-ado-sandbox.mjs",
    "setup:cert": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-dev-cert.ps1",
    "verify:ado": "node --env-file=.env scripts/setup-ado-sandbox.mjs --verify-only",
    "dev": "webpack serve --mode development --config webpack.config.cjs",
    "dev:https": "webpack serve --mode development --config webpack.config.cjs --env https",
    "dev:verify": "webpack serve --mode development --config webpack.config.cjs --env https --env strict",
    "build": "webpack --mode production --config webpack.config.cjs && node scripts/check-bundle-size.mjs",
    "build:dev": "webpack --mode development --config webpack.config.cjs",
    "size": "node scripts/check-bundle-size.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run --incremental",
    "test:mutation:full": "stryker run --force",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test --project=chromium --repeat-each=2",
    "e2e:auth": "playwright test --project=setup --headed",
    "e2e:headed": "playwright test --project=chromium --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:docker": "node scripts/visual-docker.mjs",
    "test:visual:update": "node scripts/visual-docker.mjs --update",
    "test:visual:report": "playwright show-report playwright-report-visual",
    "gif:showcase": "node scripts/gif/build-showcase.mjs",
    "package:dev": "node scripts/build-icons.mjs && node --env-file=.env scripts/package-extension.mjs --mode dev",
    "package:prod": "node scripts/build-icons.mjs && node --env-file=.env scripts/package-extension.mjs --mode prod",
    "icons:build": "node scripts/build-icons.mjs",
    "publish:dev": "node --env-file=.env scripts/publish-extension.mjs --mode dev",
    "publish:prod": "node --env-file=.env scripts/publish-extension.mjs --mode prod",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','build','.webpack-cache']){try{fs.rmSync(d,{recursive:true,force:true});}catch{}}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,scss,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@microsoft/1ds-core-js": "^4.4.3",
    "@microsoft/1ds-post-js": "^4.4.3",
    "azure-devops-extension-api": "^4.270.0",
    "azure-devops-extension-sdk": "^4.2.0",
    "diff-match-patch": "^1.0.5",
    "github-markdown-css": "^5.9.0",
    "mermaid": "^11.16.0",
    "parse5": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-webpack-plugin": "^5.6.7",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "knip": "^6.27.0",
    "lint-staged": "^17.1.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "3.8.3",
    "sass": "^1.101.0",
    "sass-loader": "^14.2.1",
    "storybook": "^10.5.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "tfx-cli": "^0.23.4",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "webpack": "^5.108.4",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shudv/easy-markdown-review-ado.git"
  }
}
