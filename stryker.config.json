{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "_comment": "Mutation testing config. Uses the vitest runner scoped to the fast jsdom `unit` project (the `storybook` browser project is too slow/flaky to run per-mutant). Mutates the pure-logic TS modules that the unit suite actually exercises; the SDK-glue containers and browser-only React shells are excluded (same set that vitest.config.ts drops from coverage), as are test fixtures and the hooks/DOM helpers only the Storybook suite exercises (keep this list in step with vitest.config.ts and with modules split out of components). Mutants that cannot change observable behaviour are disabled in place with a `// Stryker disable next-line <Mutator>: <reason>` comment (dead code says so and is a removal candidate); every other mutant must be caught by a scenario test.",
    "packageManager": "npm",
    "testRunner": "vitest",
    "vitest": {
        "configFile": "vitest.stryker.config.ts"
    },
    "ignorePatterns": [
        "test-results",
        "test-results-visual",
        "playwright-report",
        "playwright-report-visual",
        "coverage",
        "storybook-static",
        "build",
        "dist",
        "*.log"
    ],
    "reporters": ["html", "clear-text", "progress"],
    "htmlReporter": {
        "fileName": "reports/mutation/mutation.html"
    },
    "coverageAnalysis": "perTest",
    "incremental": true,
    "incrementalFile": "reports/stryker-incremental.json",
    "thresholds": {
        "high": 99,
        "low": 95,
        "break": 98
    },
    "mutate": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.d.ts",
        "!src/**/*.stories.tsx",
        "!src/**/*.html",
        "!src/comments/fixtures.ts",
        "!src/comments/fixtures/**",
        "!src/shell/components/excalidrawScene.fixture.ts",
        "!src/shell/useWikiSubpages.ts",
        "!src/shell/shell/useActiveArticle.ts",
        "!src/shell/shell/useActiveDiff.ts",
        "!src/shell/shell/useCommentWrites.ts",
        "!src/shell/shell/useDocNavigation.ts",
        "!src/shell/shell/useDocScroll.ts",
        "!src/shell/shell/useDraftController.ts",
        "!src/shell/shell/useIterationControls.ts",
        "!src/shell/shell/useLinkCopy.ts",
        "!src/shell/shell/usePaneResize.ts",
        "!src/shell/shell/useRailModel.ts",
        "!src/shell/shell/useReaderPrefs.ts",
        "!src/shell/shell/useReaderToggles.ts",
        "!src/shell/shell/useReviewHistory.ts",
        "!src/shell/shell/useThreadStore.ts",
        "!src/shell/shell/useTooNarrow.ts",
        "!src/shell/components/ArticleView.clicks.ts",
        "!src/shell/components/ArticleView.headingLinks.ts",
        "!src/shell/components/ArticleView.highlights.ts",
        "!src/shell/components/ArticleView.wrap.ts",
        "!src/shell/components/CommentRow.hooks.ts",
        "!src/shell/components/DocNav.collapsedDirs.ts",
        "!src/shell/components/DocNav.model.ts",
        "!src/shell/components/ReaderStatusBar.hooks.ts",
        "!src/shell/components/composerBusy.ts",
        "!src/markdown/safeHtmlPolicy.ts",
        "!src/types.ts",
        "!src/shell/types.ts",
        "!src/globals.d.ts",
        "!src/telemetry/**",
        "!src/shell/adoGitData.ts",
        "!src/shell/adoClients.ts",
        "!src/shell/adoSessionSdk.ts",
        "!src/shell/adoCommentApi.ts",
        "!src/shell/adoAttachmentMedia.ts",
        "!src/shell/adoRepositoryImages.ts",
        "!src/shell/commentHousing.ts",
        "!src/shell/commentPermission.ts",
        "!src/editing/adoDocEdit.ts",
        "!src/theme/markdownStyles.ts",
        "!src/theme/theme.ts",
        "!src/pr-tab/pr-tab.tsx",
        "!src/pr-tab/PrTabApp.tsx",
        "!src/pr-tab/prContext.ts",
        "!src/pr-tab/prTabHost.ts",
        "!src/hub/DocumentsApp.tsx",
        "!src/hub/DocumentsHubApp.tsx",
        "!src/hub/markdownReader.tsx",
        "!src/hub/markdownReviewHub.tsx",
        "!src/**/*.tsx"
    ]
}
